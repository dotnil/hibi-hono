{
  "name": "hibi-hono",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.ts",
    "start": "node src/index.ts",
    "check": "tsc --noEmit",
    "build": "npm run check",
    "test": "node --test $(find test -name '*.test.ts' -type f -print)",
    "lint": "oxlint src test",
    "format": "oxfmt --write src test package.json tsconfig.json",
    "format:check": "oxfmt --check src test package.json tsconfig.json"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.12",
    "bcrypt": "^6.0.0",
    "hono": "^4.12.9",
    "jose": "^6.2.3",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^5.8.3"
  }
}
